    stockBalance: 25,
    extraPoStock: 10,
    unitCost: 25.00,
    supplier: 'Cambridge University Press'
  });

  const [editItemState, setEditItemState] = useState<InventoryItem | null>(null);

  const filteredItems = items.filter(
    (item) =>
      item.isbn.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.title.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.imprint.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.supplier.toLowerCase().includes(searchTerm.toLowerCase())
  );

  const handleOpenAdd = () => {
    if (!isAdmin) {
      setPermissionNotice('Administrator permission required to add new inventory items.');
      setTimeout(() => setPermissionNotice(null), 4000);
      return;
    }
    setIsAdding(true);
  };

  const handleCreateSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newItem.isbn || !newItem.title) return;
    onAddItem(newItem);
    setIsAdding(false);
    setNewItem({
      isbn: '',
      title: '',
      category: 'Textbooks',
      imprint: 'CAMBRIDGE',
      minRequiredStock: 50,
      stockBalance: 25,
      extraPoStock: 10,
      unitCost: 25.00,
      supplier: 'Cambridge University Press'
    });
