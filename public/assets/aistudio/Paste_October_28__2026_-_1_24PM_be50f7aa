    if (!isAdmin) {
      setPermissionNotice('Administrator permission required to edit inventory ledger.');
      setTimeout(() => setPermissionNotice(null), 4000);
      return;
    }
    setEditingIsbn(item.isbn);
    setEditItemState({ ...item });
