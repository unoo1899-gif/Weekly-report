auth_modal_content = """import React, { useState } from 'react';
import { UserAccount, UserRole } from '../types';
import { User, Lock, Mail, Shield, CheckCircle, AlertCircle } from 'lucide-react';

interface AuthModalProps {
  isOpen: boolean;
  users: UserAccount[];
  onLogin: (user: UserAccount) => void;
  onSignUp: (user: UserAccount) => void;
}

export const AuthModal: React.FC<AuthModalProps> = ({
  isOpen,
  users,
  onLogin,
  onSignUp,
}) => {
  const [isSignUp, setIsSignUp] = useState(false);
  const [email, setEmail] = useState('');
  const [name, setName] = useState('');
  const [password, setPassword] = useState('');
  const [role, setRole] = useState<UserRole>('user');
  const [error, setError] = useState<string | null>(null);

  if (!isOpen) return null;

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);

    const trimmedEmail = email.trim().toLowerCase();
    if (!trimmedEmail || !password) {
      setError('Please provide both email and password.');
      return;
    }

    if (isSignUp) {
      if (!name.trim()) {
        setError('Please provide your full name.');
        return;
      }
      const existing = users.find((u) => u.email.toLowerCase() === trimmedEmail);
      if (existing) {
        setError('An account with this email already exists. Please log in.');
        return;
      }
      const newUser: UserAccount = {
        email: trimmedEmail,
        name: name.trim(),
        role,
        password,
      };
      onSignUp(newUser);
    } else {
      const found = users.find((u) => u.email.toLowerCase() === trimmedEmail);
      if (!found) {
        setError('No account found with this email. Please sign up.');
        return;
      }
      if (found.password && found.password !== password) {
        setError('Incorrect password.');
        return;
      }
      onLogin(found);
    }
  };

  const fillDemoAdmin = () => {
    setEmail('admin@wms.com');
    setPassword('admin123');
    setIsSignUp(false);
  };

  const fillDemoUser = () => {
    setEmail('user@wms.com');
    setPassword('user123');
    setIsSignUp(false);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-fadeIn">
      <div className="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md overflow-hidden shadow-2xl">
        {/* Header */}
        <div className="px-6 py-6 border-b border-slate-800 bg-slate-950/60 text-center">
          <div className="w-12 h-12 rounded-xl bg-cyan-600 flex items-center justify-center text-white font-bold mx-auto mb-3 shadow-lg shadow-cyan-900/40">
            <User className="w-6 h-6" />
          </div>
          <h2 className="text-xl font-bold text-white">
            {isSignUp ? 'Create WMS Account' : 'WMS Secure Login'}
          </h2>
          <p className="text-xs text-slate-400 mt-1">
            {isSignUp
              ? 'Register with your email as username to access inventory systems'
              : 'Sign in to access replenishment dashboards and inventory tools'}
          </p>
        </div>

        {/* Form Body */}
        <form onSubmit={handleSubmit} className="p-6 space-y-4">
          {error && (
            <div className="flex items-center gap-2 p-3 bg-rose-950/50 border border-rose-900/60 rounded-xl text-rose-300 text-xs">
              <AlertCircle className="w-4 h-4 shrink-0 text-rose-400" />
              <span>{error}</span>
            </div>
          )}

          {isSignUp && (
            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">Full Name</label>
              <input
                type="text"
                required
                placeholder="John Doe"
                value={name}
                onChange={(e) => setName(e.target.value)}
                className="w-full bg-slate-950 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-500"
              />
            </div>
          )}

          <div>
            <label className="block text-xs font-medium text-slate-300 mb-1">Email Address (Username)</label>
            <div className="relative">
              <Mail className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
              <input
                type="email"
                required
                placeholder="name@company.com"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                className="w-full bg-slate-950 border border-slate-700 rounded-xl pl-10 pr-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-500 font-mono"
              />
            </div>
          </div>

          <div>
            <label className="block text-xs font-medium text-slate-300 mb-1">Password</label>
            <div className="relative">
              <Lock className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
              <input
                type="password"
                required
                placeholder="••••••••"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                className="w-full bg-slate-950 border border-slate-700 rounded-xl pl-10 pr-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-cyan-500"
              />
            </div>
          </div>

          {isSignUp && (
            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1">Assign Role</label>
              <div className="grid grid-cols-2 gap-3">
                <button
                  type="button"
                  onClick={() => setRole('user')}
                  className={`px-4 py-2.5 rounded-xl border text-xs font-medium transition-all text-center ${
                    role === 'user'
                      ? 'bg-cyan-950/60 border-cyan-500 text-cyan-300 shadow-sm'
                      : 'bg-slate-950 border-slate-800 text-slate-400 hover:text-slate-200'
                  }`}
                >
                  Standard User
                </button>
                <button
                  type="button"
                  onClick={() => setRole('admin')}
                  className={`px-4 py-2.5 rounded-xl border text-xs font-medium transition-all text-center ${
                    role === 'admin'
                      ? 'bg-cyan-950/60 border-cyan-500 text-cyan-300 shadow-sm'
                      : 'bg-slate-950 border-slate-800 text-slate-400 hover:text-slate-200'
                  }`}
                >
                  Administrator
                </button>
              </div>
              <p className="text-[11px] text-slate-400 mt-1.5">
                {role === 'admin'
                  ? 'Admins can manage users, configure preset par stock, and manage inventory ledger.'
                  : 'Users can view replenishment dashboards and upload stock balance counts.'}
              </p>
            </div>
          )}

          <button
            type="submit"
            className="w-full py-3 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-cyan-900/30 transition-all mt-2"
          >
            {isSignUp ? 'Complete Sign Up' : 'Sign In'}
          </button>

          <div className="flex items-center justify-between pt-2">
            <button
              type="button"
              onClick={() => {
                setIsSignUp(!isSignUp);
                setError(null);
              }}
              className="text-xs text-cyan-400 hover:underline"
            >
              {isSignUp ? 'Already have an account? Sign In' : "Don't have an account? Sign Up"}
            </button>
          </div>

          {/* Quick Demo Login Buttons */}
          <div className="pt-4 border-t border-slate-800/80 space-y-2">
            <p className="text-[11px] text-slate-400 font-mono text-center">Quick Demo Accounts:</p>
            <div className="grid grid-cols-2 gap-2">
              <button
                type="button"
                onClick={fillDemoAdmin}
                className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-cyan-300 text-[11px] font-mono rounded-lg border border-slate-700 transition-colors"
              >
                Demo Admin
              </button>
              <button
                type="button"
                onClick={fillDemoUser}
                className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-emerald-300 text-[11px] font-mono rounded-lg border border-slate-700 transition-colors"
              >
                Demo User
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  );
};
"""

with open(os.path.join(base_dir, 'components/AuthModal.tsx'), 'w', encoding='utf-8') as f:
    f.write(auth_modal_content)

print("Created AuthModal.tsx")


