                <input
                  type="text"
                  value={newItem.imprint}
                  onChange={(e) => setNewItem({ ...newItem, imprint: e.target.value })}
                  className="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white uppercase font-mono"
                />
              </div>
              <div>
                <label className="block text-[11px] font-medium text-slate-400 mb-1">Min Required Stock</label>
                <input
                  type="number"
                  min="0"
                  value={newItem.minRequiredStock}
                  onChange={(e) => setNewItem({ ...newItem, minRequiredStock: parseInt(e.target.value) || 0 })}
                  className="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white font-mono"
                />
