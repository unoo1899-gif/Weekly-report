import { Navbar } from './components/Navbar';
import { MetricCards } from './components/MetricCards';
import { ReplenishmentTable } from './components/ReplenishmentTable';
import { MinStockTable } from './components/MinStockTable';
import { InventoryLedger } from './components/InventoryLedger';
import { UploadModal } from './components/UploadModal';
import { ExportModal } from './components/ExportModal';
import { AuthModal } from './components/AuthModal';
import { UserManagementModal } from './components/UserManagementModal';

const DEFAULT_USERS: UserAccount[] = [
  { email: 'admin@wms.com', name: 'System Administrator', role: 'admin', password: 'admin123' },
  { email: 'user@wms.com', name: 'Standard Operator', role: 'user', password: 'user123' },
];

export default function App() {
  const [items, setItems] = useState<InventoryItem[]>(() => {
    const saved = localStorage.getItem('wms_phase1_inventory');
    if (saved) {
      try {
        return JSON.parse(saved);
      } catch (e) {
        console.error('Failed to load saved inventory', e);
      }
    }
    return INITIAL_INVENTORY_ITEMS;
  });

  const [users, setUsers] = useState<UserAccount[]>(() => {
    const savedUsers = localStorage.getItem('wms_phase1_users');
    if (savedUsers) {
      try {
        return JSON.parse(savedUsers);
      } catch (e) {
        console.error('Failed to load saved users', e);
      }
    }
    return DEFAULT_USERS;
  });

  const [currentUser, setCurrentUser] = useState<UserAccount | null>(() => {
    const savedCurrent = localStorage.getItem('wms_phase1_current_user');
    if (savedCurrent) {
      try {
        return JSON.parse(savedCurrent);
      } catch (e) {
        console.error('Failed to load current user', e);
      }
    }
    return DEFAULT_USERS[0]; // Default logged-in admin for convenience
  });

  const [activeTab, setActiveTab] = useState<ActiveTab>('replenishment');
  const [uploadModalOpen, setUploadModalOpen] = useState(false);
  const [uploadType, setUploadType] = useState<UploadType>('balance');
  const [exportModalOpen, setExportModalOpen] = useState(false);
  const [userMgmtOpen, setUserMgmtOpen] = useState(false);

  useEffect(() => {
    localStorage.setItem('wms_phase1_inventory', JSON.stringify(items));
  }, [items]);

  useEffect(() => {
    localStorage.setItem('wms_phase1_users', JSON.stringify(users));
  }, [users]);

  useEffect(() => {
    if (currentUser) {
      localStorage.setItem('wms_phase1_current_user', JSON.stringify(currentUser));
    } else {
      localStorage.removeItem('wms_phase1_current_user');
    }
  }, [currentUser]);

  const handleLogin = (user: UserAccount) => {
    setCurrentUser(user);
  };

  const handleSignUp = (newUser: UserAccount) => {
    setUsers((prev) => [...prev, newUser]);
    setCurrentUser(newUser);
  };

  const handleLogout = () => {
    setCurrentUser(null);
  };

  const handleUpdateUserRole = (email: string, newRole: 'admin' | 'user') => {
    setUsers((prev) =>
      prev.map((u) => (u.email.toLowerCase() === email.toLowerCase() ? { ...u, role: newRole } : u))
    );
    if (currentUser && currentUser.email.toLowerCase() === email.toLowerCase()) {
      setCurrentUser({ ...currentUser, role: newRole });
    }
  };

  const handleDeleteUser = (email: string) => {
    setUsers((prev) => prev.filter((u) => u.email.toLowerCase() !== email.toLowerCase()));
  };

  const handleAddUser = (user: UserAccount) => {
    setUsers((prev) => [...prev, user]);
  };

  const handleOpenUploadModal = (type: UploadType) => {
    setUploadType(type);
    setUploadModalOpen(true);
  };

  const handleUpdateStock = (type: UploadType, updates: { isbn: string; qty: number }[]) => {
    setItems((prevItems) => {
      return prevItems.map((item) => {
        const found = updates.find((u) => u.isbn.toLowerCase() === item.isbn.toLowerCase());
        if (found) {
          if (type === 'balance') {
            return { ...item, stockBalance: found.qty, lastStockUpdate: new Date().toISOString().slice(0, 16).replace('T', ' ') };
          } else {
            return { ...item, extraPoStock: found.qty, lastPoUpdate: new Date().toISOString().slice(0, 16).replace('T', ' ') };
          }
        }
        return item;
      });
    });
  };

  const handleUpdateMinStock = (isbn: string, newMinStock: number) => {
    if (currentUser?.role !== 'admin') {
      alert('Administrator permission required to change preset minimum stock.');
      return;
    }
    setItems((prevItems) =>
      prevItems.map((item) => (item.isbn === isbn ? { ...item, minRequiredStock: newMinStock } : item))
    );
  };

  const handleAddItem = (newItem: InventoryItem) => {
    if (currentUser?.role !== 'admin') {
      alert('Administrator permission required to add inventory items.');
      return;
    }
    setItems((prev) => [newItem, ...prev]);
  };

  const handleUpdateItem = (updatedItem: InventoryItem) => {
    if (currentUser?.role !== 'admin') {
      alert('Administrator permission required to update inventory items.');
      return;
    }
    setItems((prev) => prev.map((item) => (item.isbn === updatedItem.isbn ? updatedItem : item)));
  };

  const handleDeleteItem = (isbn: string) => {
    if (currentUser?.role !== 'admin') {
      alert('Administrator permission required to delete inventory items.');
      return;
    }
    setItems((prev) => prev.filter((item) => item.isbn !== isbn));
  };

  const handleResetData = () => {
    if (currentUser?.role !== 'admin') {
      alert('Administrator permission required to reset demo data.');
      return;
    }
    if (window.confirm('Reset all inventory data and minimum stock presets to initial demo state?')) {
      setItems(INITIAL_INVENTORY_ITEMS);
      localStorage.removeItem('wms_phase1_inventory');
    }
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
      {/* Auth Modal if not logged in */}
      <AuthModal
        isOpen={!currentUser}
        users={users}
        onLogin={handleLogin}
        onSignUp={handleSignUp}
      />

      {currentUser && (
        <>
          {/* Top Navigation */}
          <Navbar
            activeTab={activeTab}
            setActiveTab={setActiveTab}
            onOpenUploadModal={handleOpenUploadModal}
            onOpenExportModal={() => setExportModalOpen(true)}
            onResetData={handleResetData}
            currentUser={currentUser}
            onOpenUserManagement={() => setUserMgmtOpen(true)}
            onLogout={handleLogout}
          />

          {/* Main Content Container */}
          <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
            {/* KPI Summary Cards */}
            <MetricCards items={items} />

            {/* Tab Content */}
            {activeTab === 'replenishment' && (
              <ReplenishmentTable
                items={items}
                onOpenUploadModal={handleOpenUploadModal}
                onOpenExportModal={() => setExportModalOpen(true)}
              />
            )}

            {activeTab === 'preset-stock' && (
              <MinStockTable
                items={items}
                onUpdateMinStock={handleUpdateMinStock}
                currentUser={currentUser}
              />
            )}

            {activeTab === 'inventory-ledger' && (
              <InventoryLedger
                items={items}
                onAddItem={handleAddItem}
                onUpdateItem={handleUpdateItem}
                onDeleteItem={handleDeleteItem}
                currentUser={currentUser}
              />
            )}
          </main>

          {/* Footer */}
          <footer className="border-t border-slate-800/80 bg-slate-900/40 py-6 text-center text-xs text-slate-400">
            <p>WMS Phase 1 Order Management & Stock Replenishment Engine · Built with Google AI Studio</p>
          </footer>

          {/* Modals */}
          <UploadModal
            isOpen={uploadModalOpen}
            onClose={() => setUploadModalOpen(false)}
            uploadType={uploadType}
            items={items}
            onUpdateStock={handleUpdateStock}
          />

          <ExportModal
            isOpen={exportModalOpen}
            onClose={() => setExportModalOpen(false)}
            items={items}
          />

          <UserManagementModal
            isOpen={userMgmtOpen}
            onClose={() => setUserMgmtOpen(false)}
            users={users}
            currentUser={currentUser}
            onUpdateUserRole={handleUpdateUserRole}
            onDeleteUser={handleDeleteUser}
            onAddUser={handleAddUser}
          />
        </>
      )}
    </div>
  );
}
"""

