min_stock_content = """import React, { useState } from 'react';
import { InventoryItem, UserAccount } from '../types';
import { Sliders, Search, Edit2, Check, X, ShieldAlert } from 'lucide-react';

interface MinStockTableProps {
  items: InventoryItem[];
  onUpdateMinStock: (isbn: string, newMinStock: number) => void;
  currentUser: UserAccount;
}

export const MinStockTable: React.FC<MinStockTableProps> = ({ items, onUpdateMinStock, currentUser }) => {
  const [searchTerm, setSearchTerm] = useState('');
  const [editingIsbn, setEditingIsbn] = useState<string | null>(null);
  const [editValue, setEditValue] = useState<number>(0);
  const [permissionNotice, setPermissionNotice] = useState<string | null>(null);

  const isAdmin = currentUser.role === 'admin';

  const filteredItems = items.filter(
    (item) =>
      item.isbn.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.title.toLowerCase().includes(searchTerm.toLowerCase()) ||
      item.imprint.toLowerCase().includes(searchTerm.toLowerCase())
  );

  const handleStartEdit = (item: InventoryItem) => {
    if (!isAdmin) {
      setPermissionNotice('Administrator permission required to modify preset minimum required stock.');
      setTimeout(() => setPermissionNotice(null), 4000);
      return;
    }
    setEditingIsbn(item.isbn);
    setEditValue(item.minRequiredStock);
  };

  const handleSaveEdit = (isbn: string) => {
    if (!isNaN(editValue) && editValue >= 0) {
      onUpdateMinStock(isbn, editValue);
    }
    setEditingIsbn(null);
  };

  return (
    <div className="space-y-4">
      {permissionNotice && (
        <div className="flex items-center gap-3 p-4 bg-amber-950/40 border border-amber-900/60 rounded-xl text-amber-300 text-xs animate-fadeIn">
          <ShieldAlert className="w-5 h-5 shrink-0 text-amber-400" />
          <span>{permissionNotice}</span>
        </div>
      )}

      <div className="bg-slate-900 border border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        {/* Header toolbar */}
        <div className="p-6 border-b border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-cyan-950/60 text-cyan-400 border border-cyan-800/50 flex items-center justify-center">
              <Sliders className="w-5 h-5" />
            </div>
            <div>
              <h2 className="text-lg font-bold text-white">Preset Minimum Required Stock</h2>
              <p className="text-xs text-slate-400">
                {isAdmin ? 'Configure safety par levels for automated replenishment calculations.' : 'View safety par levels (Admin privileges required to edit).'}
              </p>
            </div>
          </div>

          <div className="relative w-full sm:w-72">
            <Search className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
            <input
              type="text"
              placeholder="Search ISBN, title or imprint..."
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
              className="w-full bg-slate-950 border border-slate-700 rounded-xl pl-10 pr-4 py-2 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500"
            />
          </div>
        </div>

        {/* Table */}
        <div className="overflow-x-auto">
          <table className="w-full text-left border-collapse">
            <thead>
              <tr className="bg-slate-950/60 text-[11px] font-mono text-slate-400 uppercase tracking-wider border-b border-slate-800">
                <th className="py-3 px-6">ISBN</th>
                <th className="py-3 px-6">Title</th>
                <th className="py-3 px-6">Imprint</th>
                <th className="py-3 px-6 text-right">Min Required Stock (Par)</th>
                <th className="py-3 px-6 text-center">Actions</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-800/60 text-xs">
              {filteredItems.map((item) => {
                const isEditing = editingIsbn === item.isbn;
                return (
                  <tr key={item.isbn} className="hover:bg-slate-800/40 transition-colors">
                    <td className="py-4 px-6 font-mono text-cyan-400 font-medium whitespace-nowrap">{item.isbn}</td>
                    <td className="py-4 px-6 text-slate-100 font-medium">{item.title}</td>
                    <td className="py-4 px-6 text-slate-300 font-mono text-[11px] whitespace-nowrap">
                      <span className="px-2 py-1 rounded bg-slate-800 border border-slate-700 text-cyan-300">
                        {item.imprint}
                      </span>
                    </td>
                    <td className="py-4 px-6 text-right font-mono tabular-nums">
                      {isEditing ? (
                        <input
                          type="number"
                          min="0"
                          value={editValue}
                          onChange={(e) => setEditValue(parseInt(e.target.value) || 0)}
                          className="w-24 bg-slate-950 border border-cyan-500 rounded-lg px-2 py-1 text-right text-white font-mono text-xs focus:outline-none"
                          autoFocus
                        />
                      ) : (
                        <span className="text-white font-semibold text-sm">{item.minRequiredStock.toLocaleString()}</span>
                      )}
                    </td>
                    <td className="py-4 px-6 text-center">
                      {isEditing ? (
                        <div className="flex items-center justify-center gap-1.5">
                          <button
                            onClick={() => handleSaveEdit(item.isbn)}
                            className="p-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition-colors"
                            title="Save"
                          >
                            <Check className="w-4 h-4" />
                          </button>
                          <button
                            onClick={() => setEditingIsbn(null)}
                            className="p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white rounded-lg transition-colors"
                            title="Cancel"
                          >
                            <X className="w-4 h-4" />
                          </button>
                        </div>
                      ) : (
                        <button
                          onClick={() => handleStartEdit(item)}
                          className={`inline-flex items-center gap-1 px-3 py-1 rounded-lg border transition-colors ${
                            isAdmin
                              ? 'bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border-slate-700'
                              : 'bg-slate-900 text-slate-500 border-slate-800 cursor-not-allowed'
                          }`}
                        >
                          <Edit2 className="w-3.5 h-3.5 text-cyan-400" />
                          <span>Edit Par</span>
                        </button>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};
"""

