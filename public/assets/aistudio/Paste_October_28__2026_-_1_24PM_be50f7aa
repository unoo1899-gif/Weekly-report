user_mgmt_content = """import React, { useState } from 'react';
import { UserAccount, UserRole } from '../types';
import { X, Users, Shield, Trash2, Edit2, Check, UserPlus } from 'lucide-react';

interface UserManagementModalProps {
  isOpen: boolean;
  onClose: () => void;
  users: UserAccount[];
  currentUser: UserAccount;
  onUpdateUserRole: (email: string, newRole: UserRole) => void;
  onDeleteUser: (email: string) => void;
  onAddUser: (user: UserAccount) => void;
}

export const UserManagementModal: React.FC<UserManagementModalProps> = ({
  isOpen,
  onClose,
  users,
  currentUser,
  onUpdateUserRole,
  onDeleteUser,
  onAddUser,
}) => {
  const [isAdding, setIsAdding] = useState(false);
  const [newEmail, setNewEmail] = useState('');
  const [newName, setNewName] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [newRole, setNewRole] = useState<UserRole>('user');
  const [error, setError] = useState<string | null>(null);

  if (!isOpen) return null;

  const handleCreateUser = (e: React.FormEvent) => {
    e.preventDefault();
    setError(null);
    const trimmed = newEmail.trim().toLowerCase();
    if (!trimmed || !newPassword || !newName.trim()) {
      setError('All fields are required.');
      return;
    }
    if (users.some((u) => u.email.toLowerCase() === trimmed)) {
      setError('User with this email already exists.');
      return;
    }
    onAddUser({
      email: trimmed,
      name: newName.trim(),
      role: newRole,
      password: newPassword,
    });
    setNewEmail('');
    setNewName('');
    setNewPassword('');
    setIsAdding(false);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm animate-fadeIn">
      <div className="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl">
        {/* Header */}
        <div className="flex items-center justify-between px-6 py-4 border-b border-slate-800 bg-slate-950/50">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-cyan-950/60 text-cyan-400 border border-cyan-800/50 flex items-center justify-center">
              <Users className="w-5 h-5" />
            </div>
            <div>
              <h3 className="text-base font-semibold text-white">User & Permission Management</h3>
              <p className="text-xs text-slate-400">Admin control panel for managing system users and roles</p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="p-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition-colors"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Body */}
        <div className="p-6 space-y-6">
          <div className="flex items-center justify-between">
            <h4 className="text-sm font-medium text-white">Registered System Users ({users.length})</h4>
            <button
              onClick={() => setIsAdding(!isAdding)}
              className="flex items-center gap-1.5 px-3.5 py-2 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-semibold rounded-xl shadow-lg shadow-cyan-900/30 transition-all"
            >
              <UserPlus className="w-4 h-4" />
              <span>{isAdding ? 'Cancel' : 'Add New User'}</span>
            </button>
          </div>

          {isAdding && (
            <form onSubmit={handleCreateUser} className="p-4 bg-slate-950/80 border border-slate-800 rounded-xl space-y-3">
              <h5 className="text-xs font-semibold text-cyan-400">Create New User Account</h5>
              {error && <p className="text-xs text-rose-400">{error}</p>}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <input
                  type="text"
                  required
                  placeholder="Full Name"
                  value={newName}
                  onChange={(e) => setNewName(e.target.value)}
                  className="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white"
                />
                <input
                  type="email"
                  required
                  placeholder="Email (Username)"
                  value={newEmail}
                  onChange={(e) => setNewEmail(e.target.value)}
                  className="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white font-mono"
                />
                <input
                  type="password"
                  required
                  placeholder="Password"
                  value={newPassword}
                  onChange={(e) => setNewPassword(e.target.value)}
                  className="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white"
                />
                <select
                  value={newRole}
                  onChange={(e) => setNewRole(e.target.value as UserRole)}
                  className="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-white"
                >
                  <option value="user">Standard User</option>
                  <option value="admin">Administrator</option>
                </select>
              </div>
              <div className="flex justify-end pt-1">
                <button
                  type="submit"
                  className="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-medium rounded-lg"
                >
                  Save User
                </button>
              </div>
            </form>
          )}

          {/* Users Table */}
          <div className="border border-slate-800 rounded-xl overflow-hidden">
            <table className="w-full text-left border-collapse text-xs">
              <thead className="bg-slate-950 text-[11px] font-mono text-slate-400 uppercase">
                <tr>
                  <th className="p-3.5">Name / Email</th>
                  <th className="p-3.5">Role</th>
                  <th className="p-3.5">Permissions</th>
                  <th className="p-3.5 text-center">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-800/60">
                {users.map((u) => {
                  const isSelf = u.email.toLowerCase() === currentUser.email.toLowerCase();
                  return (
                    <tr key={u.email} className="hover:bg-slate-800/40">
                      <td className="p-3.5">
                        <div className="font-medium text-white">{u.name} {isSelf && '(You)'}</div>
                        <div className="font-mono text-cyan-400 text-[11px]">{u.email}</div>
                      </td>
                      <td className="p-3.5">
                        <span className={`px-2.5 py-1 rounded-full text-[11px] font-medium border ${
                          u.role === 'admin'
                            ? 'bg-purple-950/60 border-purple-800 text-purple-300'
                            : 'bg-cyan-950/60 border-cyan-800 text-cyan-300'
                        }`}>
                          {u.role === 'admin' ? 'Administrator' : 'Standard User'}
                        </span>
                      </td>
                      <td className="p-3.5 text-slate-400 text-[11px]">
                        {u.role === 'admin'
                          ? 'Full Access (Inventory, Par Levels, User Mgmt)'
                          : 'Replenishment Dashboard, Stock Balance Uploads'}
                      </td>
                      <td className="p-3.5 text-center">
                        <div className="flex items-center justify-center gap-2">
                          {!isSelf && (
                            <>
                              <button
                                onClick={() => onUpdateUserRole(u.email, u.role === 'admin' ? 'user' : 'admin')}
                                className="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px] rounded border border-slate-700 transition-colors"
                              >
                                Toggle Role
                              </button>
                              <button
                                onClick={() => onDeleteUser(u.email)}
                                className="p-1.5 bg-slate-800 hover:bg-slate-700 text-rose-400 rounded transition-colors border border-slate-700"
                                title="Delete User"
                              >
                                <Trash2 className="w-3.5 h-3.5" />
                              </button>
                            </>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  );
};
"""

with open(os.path.join(base_dir, 'components/UserManagementModal.tsx'), 'w', encoding='utf-8') as f:
    f.write(user_mgmt_content)

print("Created UserManagementModal.tsx")


