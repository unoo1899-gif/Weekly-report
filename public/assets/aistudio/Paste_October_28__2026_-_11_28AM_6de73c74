    .map((item) => {
      const deficit = item.minRequiredStock - item.stockBalance - item.extraPoStock;
      return {
        ...item,
        orderQty: Math.max(0, deficit),
      };
    })
    .filter((item) => item.orderQty > 0);

  const totalCost = reorderList.reduce((acc, item) => acc + item.orderQty * item.unitCost, 0);

  const handleDownloadCSV = () => {
    const headers = 'ISBN,Title,Imprint,Supplier,Min Required,Stock Balance,Extra PO,Order Quantity,Unit Cost,Total Cost\n';
    const rows = reorderList
      .map(
        (i) =>
          `"${i.isbn}","${i.title}","${i.imprint}","${i.supplier}",${i.minRequiredStock},${i.stockBalance},${i.extraPoStock},${i.orderQty},${i.unitCost},${(i.orderQty * i.unitCost).toFixed(2)}`
      )
      .join('\n');

    const blob = new Blob([headers + rows], { type: 'text/csv;charset=utf-8;' });
