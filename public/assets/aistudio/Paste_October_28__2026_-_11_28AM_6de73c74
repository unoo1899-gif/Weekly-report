import pandas as pd

df = pd.read_excel('Minimum Qty.xlsx', sheet_name='PRICE LIST')

items_code = []
for idx, row in df.iterrows():
    isbn = str(row['ISBN']).strip()
    title = str(row['TITLE']).strip().replace('"', '\\"')
    min_qty = int(row['Minimum Qty'])
    if idx < 12:
        imprint = 'CAMBRIDGE'
        publisher = 'Cambridge University Press'
    elif idx < 18:
        imprint = 'MARSHALL CAVENDISH'
        publisher = 'Marshall Cavendish'
    else:
        imprint = 'OXFORD'
        publisher = 'Oxford University Press'
        
    if 'ENGLISH' in title:
        cat = 'English'
    elif 'MATHS' in title:
        cat = 'Maths'
    else:
        cat = 'Textbooks'

    stock = idx + 3 # matching 3, 4, 5... as in the image
    po = 10 if min_qty >= 50 else 5

    item_str = f"  {{\n    isbn: '{isbn}',\n    title: \"{title}\",\n    category: '{cat}',\n    imprint: '{imprint}',\n    minRequiredStock: {min_qty},\n    stockBalance: {stock},\n    extraPoStock: {po},\n    unitCost: 25.00,\n    supplier: '{publisher}',\n    lastStockUpdate: '2026-10-26 09:00',\n    lastPoUpdate: '2026-10-26 10:00'\n  }}"
    items_code.append(item_str)

joined_items = ',\n'.join(items_code)
full_initial_data = f"import {{ InventoryItem }} from '../types';\n\nexport const INITIAL_INVENTORY_ITEMS: InventoryItem[] = [\n{joined_items}\n];\n"

print("Generated initialData with imprint successfully. Total items:", len(items_code))


